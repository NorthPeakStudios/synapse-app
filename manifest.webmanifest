{
 "id": "/synapse-app/",
 "name": "Synapse",
 "short_name": "Synapse",
 "description": "Synapse: flashcards, courses, Doctordle and anatomy for curious students.",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "display_override": [
  "standalone",
  "fullscreen",
  "minimal-ui"
 ],
 "orientation": "portrait",
 "background_color": "#f6f0e1",
 "theme_color": "#f6f0e1",
 "icons": [
  {
   "src": "apple-touch-icon.png",
   "sizes": "180x180",
   "type": "image/png"
  },
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512-maskable.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ]
}